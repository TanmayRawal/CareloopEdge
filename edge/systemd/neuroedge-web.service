[Unit]
Description=NeuroEdge web app (Flask under gunicorn)
Wants=network-online.target neuroedge-llm.service
After=network-online.target neuroedge-llm.service
# Start only once a model is available: an enrolled, verified bundle (normal) or a dev bundle directory.
ConditionPathExists=|/var/lib/neuroedge/models/mri/history.json
ConditionPathExists=|/var/lib/neuroedge/dev_bundle/bundle.json

[Service]
User=neuroedge
Group=neuroedge
WorkingDirectory=/opt/neuroedge/src
# NEUROEDGE_SECRET, NEUROEDGE_HOME, NEUROEDGE_MODEL, NEUROEDGE_LLM_URL (and NEUROEDGE_BUNDLE_DIR in dev mode)
EnvironmentFile=/etc/neuroedge/web.env
Environment=XDG_CACHE_HOME=/tmp/cache
# Decoder cap against decompression bombs (also enforced from file headers in neuroedge/preprocess.py)
Environment=OPENCV_IO_MAX_IMAGE_PIXELS=16777216
# Loopback only: browsers reach the portal through Caddy (HTTPS :443, edge/caddy/Caddyfile).
# Exactly ONE worker: one model in RAM (~1 GB), and the login rate limiter lives in process memory.
# Threads give concurrency; the SQLite database (WAL) serialises writes.
# Long timeout: an LLM narrative on the Pi can take ~30 s.
ExecStart=/opt/neuroedge/venv/bin/gunicorn --workers 1 --threads 4 --timeout 180 --worker-tmp-dir /dev/shm --no-control-socket \
          --bind 127.0.0.1:8080 "edge.serve:wsgi()"
Restart=on-failure
RestartSec=5
MemoryMax=3G
# Hardening. The model is decrypted and verified in RAM (/dev/shm). The only writable place is the
# portal's data directory (SQLite + encrypted scans/reports); everything else is read-only.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/neuroedge/portal
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
